<h1>Routes</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each routes.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, house, blood status, and train that each student it on}}
        {{#each routes}}
        <tr>
            <td>{{this.idRoute}}</td>
            <td>{{this.routeName}}</td>
            <td>{{this.duration}}</td>
            <td>{{this.frequency}}</td>

            {{! DELETE form }}
            <form id='delete_route_form'>
                <input type='hidden' name='delete_route_id' value='{{this.idRoute}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>

            {{! EDIT form }}
            <form id='edit_route_form'>
                <input type='hidden' name='edit_route_id' value='{{this.idRoute}}' />
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
        <form id='insert_route_form'>
            <input type='hidden' name='insert_route_id' />
            <td>
                <button type='submit'>
                    New Route
                </button>
            </td>
        </form>
    </tbody>
</table>