<h1>Schedules</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each schedules.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, house, blood status, and train that each student it on}}
        {{#each schedules}}
        <tr>
            <td>{{this.onRoute}}</td>
            <td>{{this.atStation}}</td>
            <td>{{this.arrivalTime}}</td>
            <td>{{this.departureTime}}</td>

            {{! DELETE form }}
            <form class='delete_schedule_form'>
                <input type='hidden' name='delete_schedule_id' value='{{this.idSchedule}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>

            {{! EDIT form }}
            <form class='edit_schedule_form'>
                <input type='hidden' name='edit_schedule_id' value='{{this.idRoute}} + {{this.idStation}}' />
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
        <form class='insert_schedule_form'>
            <input type='hidden' name='insert_schedule_id' />
            <td>
                <button type='submit'>
                    New Schedule
                </button>
            </td>
        </form>
    </tbody>
</table>