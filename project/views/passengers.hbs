<h1>Passengers</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each passengers.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, house, blood status, and train that each student it on}}
        {{#each passengers}}
        <tr>
            <td>{{this.idPassenger}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.house}}</td>
            <td>{{this.bloodStatus}}</td>
            <td>{{this.ridingTrain}}</td>

            {{! DELETE form }}
            <form id='delete_passenger_form'>
                <input type='hidden' name='delete_passenger_id' value='{{this.idPassenger}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>

            {{! EDIT form }}
            <form id='edit_passenger_form'>
                <input type='hidden' name='edit_passenger_id' value='{{this.idPassenger}}' />
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>