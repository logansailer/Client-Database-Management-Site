<h1>Passengers</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each passengers.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, house, blood status, and train that each student it on}}
        {{#each passengers}}
        <tr>
            <td>{{this.idPassenger}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.house}}</td>
            <td>{{this.bloodStatus}}</td>
            <td>{{this.ridingTrain}}</td>

            {{! DELETE form }}
            <td>
                <form class='delete_passenger_form'>
                    <input type='hidden' name='idPassenger' value='{{this.idPassenger}}' />
                        <button type='submit'>
                            Delete
                        </button>
                </form>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<script>
  document.querySelectorAll('.delete_passenger_form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const passengerId = form.querySelector('input[name="idPassenger"]').value;

      try {
        const response = await fetch('/delete-passenger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idPassenger: passengerId })
        });

        const result = await response.json();

        if (result.success) {
          // Remove the row from DOM
          const row = form.closest('tr');
          row.remove();
          alert('Passenger deleted successfully.');
        } else {
          alert('Failed to delete passenger: ' + result.message);
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    });
  });
</script>