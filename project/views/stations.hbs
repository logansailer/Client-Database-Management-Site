<h1>Stations</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            {{#each stations.[0]}}
            <th>{{@key}}</th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{#each stations}}
        <tr>
            <td>{{this.idStation}}</td>
            <td>{{this.stationName}}</td>
            <td>{{this.locationDescription}}</td>
            <td>{{this.muggleAccess}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>

<h2>Add New Station</h2>
<form id="add_station_form">
    <label>
        Station Name:
        <input type="text" name="stationName" required>
    </label>
    <label>
        Location Description:
        <input type="text" name="locationDescription">
    </label>
    <label>
        Muggle Access:
        <select name="muggleAccess" required>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
        </select>
    </label>
    <button type="submit">Add Station</button>
</form>

<script>
const addStationForm = document.getElementById('add_station_form');
addStationForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(addStationForm).entries());

    try {
        const res = await fetch('/stations/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            window.location.reload(); // reload to show updated table
        } else {
            alert('Error adding station.');
        }
    } catch (err) {
        console.error(err);
        alert('Error adding station.');
    }
});
</script>