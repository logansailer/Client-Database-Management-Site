<h1>Stations</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each stations.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, house, blood status, and train that each student it on}}
        {{#each stations}}
        <tr>
            <td>{{this.idStation}}</td>
            <td>{{this.stationName}}</td>
            <td>{{this.locationDescription}}</td>
            <td>{{this.muggleAccess}}</td>

            {{! DELETE form }}
            <form class='delete_station_form'>
                <input type='hidden' name='delete_station_id' value='{{this.idStation}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>

            {{! EDIT form }}
            <form class='edit_station_form'>
                <input type='hidden' name='edit_station_id' value='{{this.idStation}}' />
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
        <form class='insert_station_form'>
            <input type='hidden' name='insert_station_id' />
            <td>
                <button type='submit'>
                    New Station
                </button>
            </td>
        </form>
    </tbody>
</table>