<h1>Trains</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each trains.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, house, blood status, and train that each student it on}}
        {{#each trains}}
        <tr>
            <td>{{this.idTrain}}</td>
            <td>{{this.name}}</td>
            <td>{{this.maxCapacity}}</td>
            <td>{{this.onRoute}}</td>

            {{! DELETE form }}
            <form id='delete_train_form'>
                <input type='hidden' name='delete_train_id' value='{{this.idTrain}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>

            {{! EDIT form }}
            <form id='edit_train_form'>
                <input type='hidden' name='edit_train_id' value='{{this.idTrain}}' />
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>